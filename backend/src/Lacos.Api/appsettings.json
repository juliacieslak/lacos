{
  "ConnectionStrings": {
    "Supabase": ""
  },
  "Auth0": {
    "Domain": "SEU-TENANT.us.auth0.com",
    "Audience": "https://api.lacos.app",
    "ClaimsNamespace": "https://lacos.app/",
    "ManagementClientId": "",
    "ManagementClientSecret": ""
  },
  "Encryption": {
    "DataKey": "",
    "BlindIndexKey": ""
  },
  "Lgpd": {
    "TermsOfUseVersion": "1.0",
    "SensitiveDataConsentVersion": "1.0"
  },
  "Session": {
    "InactivityTimeoutMinutes": 15
  },
  "Scheduling": {
    "TimeZone": "America/Sao_Paulo"
  },
  "Invitations": {
    "ExpirationDays": 7,
    "AcceptUrl": "https://app.lacos.app/convites"
  },
  "Documents": {
    "MaxFileSizeBytes": 10485760
  },
  "Reminders": {
    "MedicationLeadMinutes": 15,
    "MedicationMissedToleranceMinutes": 60,
    "AppointmentReminderLeadMinutes": [ 1440, 60 ],
    "CareRoutineLeadMinutes": 15
  },
  "NotificationChannels": {
    "EmailEnabled": true,
    "PushEnabled": true,
    "BatchSize": 100
  },
  "BackgroundJobs": {
    "Enabled": true,
    "ReminderIntervalSeconds": 60,
    "DispatchIntervalSeconds": 15
  },
  "Integrations": {
    "Storage": {
      "Provider": "Supabase",
      "SupabaseUrl": "https://SEU-PROJETO.supabase.co",
      "ServiceRoleKey": "",
      "Bucket": "patient-documents",
      "LocalPath": "storage"
    },
    "ViaCep": {
      "BaseUrl": "https://viacep.com.br/ws/"
    },
    "Nominatim": {
      "BaseUrl": "https://nominatim.openstreetmap.org/",
      "UserAgent": "Lacos/1.0 (contato@lacos.app)",
      "MinIntervalMilliseconds": 1100
    },
    "Overpass": {
      "Endpoints": [ "https://overpass-api.de/api/interpreter", "https://overpass.kumi.systems/api/interpreter" ],
      "QueryTimeoutSeconds": 20,
      "CacheMinutes": 10,
      "UserAgent": "Lacos/1.0 (contato@lacos.app)"
    },
    "WhoIcd": {
      "Enabled": false,
      "Release": "2024-01",
      "Language": "pt",
      "ClientId": "",
      "ClientSecret": ""
    },
    "Email": {
      "Provider": "Log",
      "SendGridApiKey": "",
      "FromEmail": "nao-responda@lacos.app",
      "FromName": "Laços"
    },
    "Push": {
      "Provider": "Log",
      "OneSignalAppId": "",
      "OneSignalApiKey": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://app.lacos.app" ]
  },
  "RateLimiting": {
    "PermitPerMinute": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
