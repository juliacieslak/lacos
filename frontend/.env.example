# Copie para .env.local e preencha. Apenas valores PÚBLICOS: nunca coloque client secret ou chaves do Supabase aqui.

# Auth0 — aplicação do tipo "Single Page Application"
VITE_AUTH0_DOMAIN=seu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
# Identificador da API cadastrada no Auth0 (o mesmo valor de Auth0:Audience no backend)
VITE_AUTH0_AUDIENCE=https://api.lacos.app

# URL do backend (.NET). Em desenvolvimento, o perfil "http" da API usa a porta 5080.
VITE_API_URL=http://localhost:5080
